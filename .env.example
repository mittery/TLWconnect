# ==========================================
# TLW Connect — Environment Variables Example
# ==========================================
# IMPORTANT: DO NOT commit real secrets or .env file to Git!
# Copy this file to .env and set your real values in development,
# or add these variables in Render Dashboard for production.

# Application Environment
PORT=3000
NODE_ENV=development

# Allowed Client Origin (Production URL without trailing slash)
CLIENT_ORIGIN=https://tlwconnect.onrender.com

# Administrator Passcode (Manager portal access)
# Required in production: At least 16+ characters recommended
ADMIN_PASSCODE=your_secure_admin_passcode_here

# Teacher Verification PIN (For teachers to post official guidance/responses)
# Required in production: 6-8 digits/characters recommended
TEACHER_PIN=your_secure_teacher_pin_here

# Student Council Verification PIN (สำหรับยืนยันบทบาทสภานักเรียน)
# Required in production: 6-8 digits/characters recommended
MOD_PIN=your_secure_moderator_pin_here

# Cryptographic Salt for Student National ID Hashing (HMAC-SHA256)
# Required in production: Use a long, random string (at least 32+ characters)
# WARNING: Do NOT change this salt after users have registered, or hashes will not match!
HASH_SALT=your_random_32_character_secret_salt_here

# ==========================================
